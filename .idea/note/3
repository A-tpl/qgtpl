#加法   C = A + B，其中 cᵢⱼ = aᵢⱼ + bᵢⱼ
#矩阵数乘   B = kA，其中 bᵢⱼ = k × aᵢⱼ
#矩阵乘法   cᵢⱼ = aᵢ₁b₁ⱼ + aᵢ₂b₂ⱼ + ... + aᵢₙbₙⱼ = Σₖ₌₁ⁿ aᵢₖbₖⱼ
#python实现
    import numpy as np

    # 创建矩阵
    A = np.array([[1, 2], [3, 4]])
    B = np.array([[5, 6], [7, 8]])

    print("矩阵 A:")
    print(A)
    print("\n矩阵 B:")
    print(B)

    # 1. 矩阵加法
    print("\n1. 矩阵加法 A + B:")
    print(A + B)

    # 2. 矩阵减法
    print("\n2. 矩阵减法 A - B:")
    print(A - B)

    # 3. 矩阵数乘
    k = 3
    print(f"\n3. 矩阵数乘 {k}A:")
    print(k * A)

    # 4. 矩阵乘法
    print("\n4. 矩阵乘法 A × B:")
    print(np.dot(A, B))  # 或 A @ B

    # 5. 矩阵转置
    print("\n5. 矩阵转置 Aᵀ:")
    print(A.T)

    # 6. 矩阵行列式
    print("\n6. 矩阵行列式 det(A):")
    print(np.linalg.det(A))

    # 7. 矩阵求逆
    print("\n7. 矩阵逆 A⁻¹:")
    print(np.linalg.inv(A))

    # 8. 验证逆矩阵
    print("\n8. 验证 A × A⁻¹ = I:")
    print(np.dot(A, np.linalg.inv(A)).round(10))  # 四舍五入消除浮点误差

    # 9. 矩阵的秩
    print("\n9. 矩阵的秩 rank(A):")
    print(np.linalg.matrix_rank(A))

    # 10. 解线性方程组 Ax = b
    b = np.array([5, 6])
    print("\n10. 解方程组 Ax = b:")
    print("b =", b)
    x = np.linalg.solve(A, b)
    print("解 x =", x)
    print("验证 Ax =", np.dot(A, x))
    
