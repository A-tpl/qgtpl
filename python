🎯 核心函数深度解析

1. map()、filter()、reduce() 三剑客

# map: 对每个元素应用函数
numbers = [1, 2, 3, 4]
squared = list(map(lambda x: x**2, numbers))  # [1, 4, 9, 16]

# filter: 过滤满足条件的元素
even = list(filter(lambda x: x % 2 == 0, numbers))  # [2, 4]

# reduce: 累积计算（需从functools导入）
from functools import reduce
product = reduce(lambda a, b: a * b, numbers)  # 1*2*3*4 = 24


2. enumerate() 和 zip() 黄金搭档

# enumerate: 同时获取索引和值
fruits = ['apple', 'banana', 'cherry']
for i, fruit in enumerate(fruits, start=1):  # 从1开始计数
    print(f"{i}. {fruit}")
# 输出:
# 1. apple
# 2. banana
# 3. cherry

# zip: 打包多个序列
names = ['Alice', 'Bob']
scores = [85, 92]
for name, score in zip(names, scores):
    print(f"{name}: {score}")


3. 对象操作三兄弟

# isinstance vs type
class Animal: pass
class Dog(Animal): pass

dog = Dog()
print(isinstance(dog, Animal))  # True (检查继承链)
print(type(dog) == Animal)      # False (精确类型)

# id: 查看内存地址
a = [1, 2]
b = a
print(id(a) == id(b))  # True (同一个对象)


